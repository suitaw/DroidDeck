#!/bin/bash
# Installs the Chinese translations once; the desktop picks them up at the next login.
DONE=/var/lib/droiddeck-zh-setup-v2.done
[ -e "$DONE" ] && exit 0
sleep 20
PACKS="language-pack-zh-hans language-pack-kde-zh-hans firefox-l10n-zh-cn fonts-noto-cjk fcitx5 fcitx5-chinese-addons fcitx5-frontend-qt6 fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fcitx5-config-qt"
droiddeck-root env DEBIAN_FRONTEND=noninteractive sh -c "dpkg --configure -a; apt-get -o DPkg::Lock::Timeout=600 update -qq; apt-get -o DPkg::Lock::Timeout=600 install -y -qq --no-install-recommends $PACKS" || exit 1
# The runtime image strips translations but keeps dpkg's file lists, so find what is missing and reinstall it.
MISSING=$(for list in /var/lib/dpkg/info/*.list; do
  grep -E '^/usr/share/locale/zh_CN/LC_MESSAGES/.*\.mo$' "$list" 2>/dev/null | while read -r f; do
    [ -e "$f" ] || { basename "$list" .list; break; }
  done
done | sed 's/:.*//' | sort -u | tr '\n' ' ')
echo "missing translations in: $MISSING"
if [ -n "$MISSING" ]; then
  droiddeck-root env DEBIAN_FRONTEND=noninteractive sh -c "apt-get -o DPkg::Lock::Timeout=600 install -y -qq --reinstall --no-install-recommends $MISSING" || exit 1
fi
droiddeck-root touch "$DONE"
if [ ! -e "$HOME/.config/fcitx5/profile" ]; then
  mkdir -p "$HOME/.config/fcitx5"
  cat > "$HOME/.config/fcitx5/profile" <<'PROFILE'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=pinyin

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=pinyin
Layout=

[GroupOrder]
0=Default
PROFILE
fi
notify-send -a DroidDeck "中文语言包已安装" "注销或重启桌面后，菜单和程序会显示中文。" 2>/dev/null
true
