#!/bin/bash
# A hardware keyboard types through fcitx5; without one the Android keyboard types through droiddeck-ime.
# The app writes 1 or 0 to /etc/droiddeck/hard-keyboard. KWin holds one input method and swaps it live.
FLAG=/etc/droiddeck/hard-keyboard
ANDROID_IME=/usr/local/share/applications/droiddeck-ime.desktop
FCITX=/usr/share/applications/org.fcitx.Fcitx5.desktop

wanted() {
  if [ "$(cat "$FLAG" 2>/dev/null)" = 1 ] && [ -f "$FCITX" ]; then echo "$FCITX"; else echo "$ANDROID_IME"; fi
}

# This script starts before dbus-run-session, so it has no session bus of its own and a --notify would reach nobody.
session_bus() {
  local pid
  pid=$(pidof -s kwin_wayland) || return 1
  tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p'
}

apply() {
  [ "$1" = "$(kreadconfig6 --file kwinrc --group Wayland --key InputMethod 2>/dev/null)" ] && return
  if [ -n "${2:-}" ]; then
    # No KWin yet: leave the setting unchanged so the next pass tries again.
    export DBUS_SESSION_BUS_ADDRESS="$(session_bus)"
    [ -n "$DBUS_SESSION_BUS_ADDRESS" ] || return
  fi
  # A running fcitx5 that KWin did not start would stop KWin's own from starting.
  pkill -x fcitx5
  kwriteconfig6 --file kwinrc --group Wayland --key InputMethod ${2:+--notify} "$1"
  echo "input method: $1"
}

if [ "${1:-}" = --once ]; then
  apply "$(wanted)"
  exit 0
fi
while sleep 1; do
  apply "$(wanted)" notify
done
