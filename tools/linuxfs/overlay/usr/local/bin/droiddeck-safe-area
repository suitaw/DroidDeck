#!/usr/bin/python3
"""Keeps the panel clear of the screen's rounded corners and cutout. Maximized windows still fill the whole screen.

The app writes "left top right bottom" in physical pixels to /etc/droiddeck/safe-area.
"""
import json
import math
import os
import subprocess
import time

FLAG = "/etc/droiddeck/safe-area"
OUTPUTS = os.path.expanduser("~/.config/kwinoutputconfig.json")


def read_insets():
    try:
        values = [int(v) for v in open(FLAG).read().split()]
        return tuple(values) if len(values) == 4 else None
    except (OSError, ValueError):
        return None


def read_scale():
    try:
        for section in json.load(open(OUTPUTS)):
            if section.get("name") == "outputs":
                for output in section["data"]:
                    if "scale" in output:
                        return float(output["scale"])
    except (OSError, ValueError, KeyError):
        pass
    return 1.0


def session_bus():
    """This starts before Plasma: take the session bus from its shell, and wait for one."""
    try:
        shell = subprocess.run(["pidof", "-s", "plasmashell"], capture_output=True, text=True, check=True).stdout.strip()
        for entry in open("/proc/%s/environ" % shell, "rb").read().split(b"\0"):
            if entry.startswith(b"DBUS_SESSION_BUS_ADDRESS="):
                return entry.decode(errors="replace").partition("=")[2], shell
    except (OSError, subprocess.SubprocessError):
        pass
    return None, None


def place_panel(bus, left, right):
    script = (
        "panels().forEach(function(p){if(p.location!='bottom'&&p.location!='top')return;"
        "var w=screenGeometry(p.screen).width-%d-%d;"
        "p.alignment='left';p.offset=%d;p.minimumLength=w;p.maximumLength=w;p.length=w;});" % (left, right, left)
    )
    return subprocess.run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script],
                          env=dict(os.environ, DBUS_SESSION_BUS_ADDRESS=bus), stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, check=False).returncode == 0


def first_look(bus):
    """A new desktop opens looking like Windows 11: centered taskbar, light colors. Later changes are the user's."""
    stamp = os.path.expanduser("~/.local/share/droiddeck/first-look")
    if os.path.exists(stamp):
        return
    script = (
        "panels().forEach(function(p){var kick=0,tasks=0,tray=0;p.widgets().forEach(function(w){"
        "if(w.type=='org.kde.plasma.kickoff')kick=w.id;else if(w.type=='org.kde.plasma.icontasks')tasks=w;"
        "else if(w.type=='org.kde.plasma.systemtray')tray=w.id;});if(!kick||!tasks||!tray)return;"
        "tasks.currentConfigGroup=['General'];tasks.writeConfig('fill',false);tasks.reloadConfig();"
        "var a=p.addWidget('org.kde.plasma.panelspacer').id,b=p.addWidget('org.kde.plasma.panelspacer').id;"
        "p.currentConfigGroup=['General'];p.writeConfig('AppletOrder',[a,kick,tasks.id,b,tray].join(';'));p.reloadConfig();});"
        "desktops().forEach(function(d){d.wallpaperPlugin='org.kde.image';"
        "d.currentConfigGroup=['Wallpaper','org.kde.image','General'];"
        "d.writeConfig('Image','file:///usr/share/wallpapers/Next/');d.reloadConfig();});"
    )
    env = dict(os.environ, DBUS_SESSION_BUS_ADDRESS=bus)
    done = subprocess.run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script],
                          env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["plasma-apply-colorscheme", "BreezeLight"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if done.returncode == 0:
        os.makedirs(os.path.dirname(stamp), exist_ok=True)
        open(stamp, "w").close()


placed = None
while True:
    time.sleep(3)
    insets = read_insets()
    bus, shell = session_bus()
    if not insets or not bus:
        continue
    first_look(bus)
    state = (insets, read_scale(), shell)
    if state != placed:
        left, _, right, _ = [math.ceil(v / state[1]) for v in insets]
        if place_panel(bus, left, right):
            placed = state
