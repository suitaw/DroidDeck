#!/bin/bash
set -u
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE DESKTOP_SESSION=plasma
export KDE_FULL_SESSION=true KDE_SESSION_VERSION=6 KDE_APPLICATIONS_AS_SCOPE=0
export QT_QPA_PLATFORM="wayland;xcb" GDK_BACKEND=wayland,x11 SDL_VIDEODRIVER=wayland,x11
unset QT_QPA_PLATFORMTHEME
export QT_FORCE_STDERR_LOGGING=1
export MOZ_ENABLE_WAYLAND=1 MOZ_USE_XINPUT2=1
export SHELL=/bin/bash
export MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_SHM_NO_SEALS=1
export KWIN_COMPOSE=Q QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
export KWIN_USE_OVERLAYS=0
[ -e /etc/mpv/mpv.conf ] || { mkdir -p /etc/mpv && echo gpu-sw=yes >/etc/mpv/mpv.conf; } 2>/dev/null
for conf in client client-rt; do
  mkdir -p "/etc/pipewire/$conf.conf.d" && printf 'context.properties = {\n    module.rt = false\n}\n' >"/etc/pipewire/$conf.conf.d/droiddeck-rt.conf"
done 2>/dev/null
export DROIDDECK_NESTED_SCALE=1
export DROIDDECK_GLTHREAD=${mesa_glthread:-}
unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 mesa_glthread
if [ -n "${BL_DEBUG_DIR:-}" ]; then
  mkdir -p "$BL_DEBUG_DIR" 2>/dev/null || true
  exec >>"$BL_DEBUG_DIR/desktop.log" 2>&1
  echo "== droiddeck-desktop $(date -u '+%Y-%m-%d %H:%M:%S UTC') ${BL_WIDTH:-1280}x${BL_HEIGHT:-720}"
fi
find "$XDG_RUNTIME_DIR" -mindepth 1 -maxdepth 1 ! -name 'wayland-0*' ! -name 'keymap.xkb' -exec rm -rf {} + 2>/dev/null
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
mkdir -p /tmp/.X11-unix /tmp/.ICE-unix && chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null
export BL_DESKTOP=1
# startplasma applies this file over the session environment, and keeps what an earlier session wrote.
kwriteconfig6 --file plasma-localerc --group Formats --key LANG "${LANG:-C.UTF-8}"
if [ -n "${LANGUAGE:-}" ]; then
  kwriteconfig6 --file plasma-localerc --group Translations --key LANGUAGE "$LANGUAGE"
else
  kwriteconfig6 --file plasma-localerc --group Translations --key LANGUAGE --delete
fi
case "${LANG:-}" in zh*) (nohup /usr/local/bin/droiddeck-zh-setup >/tmp/droiddeck-zh-setup.log 2>&1 &) ;; esac
python3 /usr/local/bin/droiddeck-pad-defaults 2>&1 | sed 's/^/[pads] /'
( while sleep 30; do python3 /usr/local/bin/droiddeck-pad-defaults 2>&1 | sed 's/^/[pads] /'; done ) &
python3 /usr/local/bin/droiddeck-desktop-gpu 2>&1 | sed 's/^/[gpu] /'
/usr/local/bin/droiddeck-desktop-window-rules 2>&1 | sed 's/^/[rules] /'
( python3 /usr/local/bin/droiddeck-library-perms 2>&1 | sed 's/^/[perms] /' ) &
mkdir -p /usr/local/share/applications
cat > /usr/local/share/applications/droiddeck-ime.desktop <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Android keyboard
Exec=/usr/local/bin/droiddeck-ime
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
ENTRY
kwriteconfig6 --file kwinrc --group Effect-overview --key BorderActivate 9
kwriteconfig6 --file kwinrc --group Wayland --key VirtualKeyboardEnabled true
# Subpixel text suits LCD stripes, not this OLED panel: it leaves colored, soft edges. Use grayscale antialiasing.
kwriteconfig6 --file kdeglobals --group General --key XftSubPixel none
kwriteconfig6 --file kdeglobals --group General --key XftAntialias true
kwriteconfig6 --file kdeglobals --group General --key XftHintStyle hintslight
if [ ! -e "$HOME/.config/fontconfig/fonts.conf" ]; then
  mkdir -p "$HOME/.config/fontconfig"
  cat > "$HOME/.config/fontconfig/fonts.conf" <<'FONTS'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="font">
    <edit name="rgba" mode="assign"><const>none</const></edit>
    <edit name="lcdfilter" mode="assign"><const>lcdnone</const></edit>
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintslight</const></edit>
  </match>
</fontconfig>
FONTS
fi
# KWin here is a client of the app's compositor and has no input devices to list, so these pages can only fail.
# That group is marked immutable in /etc/xdg/kdeglobals, so kwriteconfig6 cannot add to it from the user's file.
grep -q kcm_touchpad /etc/xdg/kdeglobals 2>/dev/null ||
  sed -i '/^\[KDE Control Module Restrictions\]/a kcm_mouse.desktop=false\nkcm_touchpad.desktop=false' /etc/xdg/kdeglobals
if [ ! -e "$HOME/.config/fcitx5/config" ]; then
  mkdir -p "$HOME/.config/fcitx5"
  printf '[Hotkey/TriggerKeys]\n0=Control+space\n1=Shift+space\n\n[Hotkey/AltTriggerKeys]\n0=Shift_L\n\n[Behavior]\nActiveByDefault=True\n' > "$HOME/.config/fcitx5/config"
fi
output_scale=$(python3 -c "import json,os;print(next(o['scale'] for s in json.load(open(os.path.expanduser('~/.config/kwinoutputconfig.json'))) if s.get('name')=='outputs' for o in s['data'] if 'scale' in o))" 2>/dev/null)
if [ -n "$output_scale" ]; then
  kwriteconfig6 --file kwinrc --group Xwayland --key Scale "$output_scale"
  kwriteconfig6 --file kdeglobals --group KScreen --key XwaylandClientsScale true
fi
/usr/local/bin/droiddeck-ime-switch --once
(nohup /usr/local/bin/droiddeck-ime-switch >/tmp/droiddeck-ime-switch.log 2>&1 &)
python3 /usr/local/bin/droiddeck-open --install 2>&1 | sed 's/^/[open] /'
export APPIMAGE_EXTRACT_AND_RUN=1
[ -e /etc/xdg/kiorc ] || printf '[Executable scripts]\nbehaviourOnLaunch=execute\n' >/etc/xdg/kiorc 2>/dev/null
desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null); [ -n "$desktop_dir" ] && [ "$desktop_dir" != "$HOME" ] || desktop_dir=$HOME/Desktop
rm -f "$desktop_dir/Return.desktop" "$desktop_dir/steam.desktop" /usr/share/applications/steamdeck-steam.desktop /usr/share/applications/droiddeck-return-gaming.desktop /usr/share/applications/droiddeck-steam-x64.desktop 2>/dev/null
sed -i 's/applications:steamdeck-steam\.desktop,\?//g' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null
if command -v flatpak >/dev/null 2>&1 && [ ! -d /var/lib/pacman ]; then
  FLATPAK_BWRAP=/usr/local/bin/droiddeck-bwrap flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 &
fi
skel_done=$HOME/.local/share/droiddeck/skel-copied
if [ -d /etc/skel ] && [ ! -e "$skel_done" ]; then
  cp -rn /etc/skel/. "$HOME/" 2>/dev/null
  mkdir -p "${skel_done%/*}" && : > "$skel_done"
fi
if [ -x /usr/lib/snapd/snap-confine ] && [ ! -d /var/lib/pacman ]; then
  /usr/local/bin/droiddeck-snapd >/dev/null 2>&1 &
  export XDG_DATA_DIRS=/var/lib/snapd/desktop:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
  export PATH=$PATH:/snap/bin
fi
update-mime-database /usr/share/mime >/dev/null 2>&1 &
[ -f /usr/share/icons/hicolor/icon-theme.cache ] || gtk-update-icon-cache -q -t /usr/share/icons/hicolor 2>/dev/null &
[ -f /usr/share/glib-2.0/schemas/gschemas.compiled ] || glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null
if [ -f "$HOME/.droiddeck-desktop-debug" ]; then
  mkdir -p "$HOME/.cache/droiddeck"
  export MOZ_LOG="nsHttp:3,nsSocketTransport:3,nsHostResolver:4,NetworkLinkService:5,NetworkConnectivityService:5,nsIOService:5"
  export MOZ_LOG_FILE="$HOME/.cache/droiddeck/firefox-net.log"
  export QT_LOGGING_RULES="kwin_*.debug=true"
fi
if [ -f "$HOME/.droiddeck-remote-run" ]; then
  mkdir -p "$HOME/.cache/droiddeck/run"
  (
    while sleep 1; do
      for f in "$HOME"/.cache/droiddeck/run/*.sh; do
        [ -f "$f" ] || continue
        mv -f "$f" "$f.running" || continue
        ( echo "[run] $(basename "$f") started"; WAYLAND_DISPLAY=wayland-1 DISPLAY=:1 bash "$f.running" 2>&1 | sed "s/^/[run] /"; echo "[run] $(basename "$f") exited"; rm -f "$f.running" ) &
      done
    done
  ) &
fi
if [ "$(cat /usr/share/droiddeck/kwin-compositor 2>/dev/null)" = opengl ]; then
  unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND
  export KWIN_COMPOSE=O2 MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink LIBGL_KOPPER_DRI2=true
  if [ -z "${KWIN_RENDER_NODES:-}" ]; then
    for node in /dev/dri/renderD0 /dev/dri/renderD307 /dev/dri/renderD*; do
      if [ -c "$node" ]; then export KWIN_RENDER_NODES="$node"; break; fi
    done
  fi
  mkdir -p /run/droiddeck/kwin
  printf '#!/bin/sh\nGALLIUM_THREAD=0 exec /usr/bin/kwin_wayland "$@"\n' > /run/droiddeck/kwin/kwin_wayland
  chmod 755 /run/droiddeck/kwin/kwin_wayland
  export PATH=/run/droiddeck/kwin:$PATH
fi
echo "== droiddeck-desktop: Plasma on $WAYLAND_DISPLAY"
# Mesa's driver thread corrupts the shell's heap when a panel popup opens (the clipboard, reliably), as it does for KWin.
mkdir -p "$HOME/.config/autostart"
[ -e /etc/xdg/autostart/org.kde.plasmashell.desktop ] && sed 's|^Exec=.*|Exec=env GALLIUM_THREAD=0 /usr/bin/plasmashell|' \
  /etc/xdg/autostart/org.kde.plasmashell.desktop > "$HOME/.config/autostart/org.kde.plasmashell.desktop"
# Plasma's shell draws the wallpaper and panel, so its death leaves a black screen. Bring it back, and record why
# it died. KCrash's own restart can fail, and the shell aborts inside glibc with nothing else in the logs.
# gdb costs 250 MB, so it only watches a shell that has already been restarted once.
(
  mkdir -p "$HOME/.cache/droiddeck"
  crashlog="$HOME/.cache/droiddeck/plasmashell-crash.log"
  starts=()
  watched=
  seen=
  restarted=
  while sleep 3; do
    manager=$(pidof -s ksmserver)
    if shell=$(pidof -s plasmashell); then
      seen=1
      if [ -n "$restarted" ] && [ "$shell" != "$watched" ] && command -v gdb >/dev/null; then
        watched=$shell
        (gdb -q -nx -batch -p "$shell" -ex 'set pagination off' -ex 'handle all nostop noprint pass' \
          -ex 'handle SIGABRT SIGSEGV SIGBUS SIGILL stop print nopass' -ex continue -ex 'bt 40' 2>&1 |
          grep -E '^#[0-9]|signal' | { read -r first && { date; echo "$first"; cat; } >> "$crashlog"; }) &
      fi
      continue
    fi
    [ -n "$manager" ] && [ -n "$seen" ] || continue
    sleep 4
    pidof -s plasmashell >/dev/null && continue
    now=$(date +%s)
    recent=()
    for t in "${starts[@]}"; do [ $((now - t)) -lt 120 ] && recent+=("$t"); done
    starts=("${recent[@]}" "$now")
    if [ "${#starts[@]}" -gt 4 ]; then echo "== droiddeck-desktop: plasmashell keeps dying; giving up"; break; fi
    echo "== droiddeck-desktop: plasmashell is gone; starting it again"
    restarted=1
    xargs -0 -a "/proc/$manager/environ" sh -c 'exec env -i "$@" GALLIUM_THREAD=0 setsid plasmashell --no-respawn' sh >/dev/null 2>&1 &
  done
) &
(nohup /usr/local/bin/droiddeck-safe-area >/tmp/droiddeck-safe-area.log 2>&1 &)
(nohup /usr/local/bin/droiddeck-desktop-links >/tmp/droiddeck-desktop-links.log 2>&1 &)
(env -u DBUS_SESSION_BUS_ADDRESS nohup /usr/local/bin/droiddeck-x11-ime >/tmp/droiddeck-x11-ime.log 2>&1 &)
kwriteconfig6 --file kwinrc --group Plugins --key shakecursorEnabled false
kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled true
kwriteconfig6 --file kwinrc --group Plugins --key contrastEnabled true
# Background services with nothing to do on a phone.
mkdir -p "$HOME/.config/autostart"
# im-launch would start a second fcitx5 next to the one KWin runs; baloo indexes every file.
for entry in org.kde.kdeconnect.daemon org.kde.kunifiedpush-distributor im-launch baloo_file geoclue-demo-agent kup-daemon orca-autostart snap-userd-autostart; do
  [ -e "/etc/xdg/autostart/$entry.desktop" ] && printf '[Desktop Entry]\nHidden=true\n' > "$HOME/.config/autostart/$entry.desktop"
done
# KWin splits this variable on commas. Unset, that gives [""], which matches the nameless keyboard of its Wayland
# backend, so every key skipped the input method and fcitx5 never saw one.
export KWIN_DEVICE_SKIPS_INPUT_METHOD=droiddeck-none
dbus-run-session -- startplasma-wayland
rc=$?
echo "== droiddeck-desktop: Plasma ended ($rc)"
exit $rc
